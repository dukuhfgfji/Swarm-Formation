      <arg name="map_size_z" value="$(arg map_size_z)"/>
      <arg name="odom_topic" value="$(arg odom_topic)"/>
    </include>
  </group>

  <group ns="drone_14" if="$(eval swarm_num>14)">
    <include file="$(find ego_planner)/launch/run_in_sim.launch">
      <arg name="drone_id" value="14"/>

      <arg name="init_x" value="-28.54"/>
      <arg name="init_y" value="-3.54"/>
      <arg name="init_z" value="1.40"/>

      <arg name="target_x" value="21.46"/>
