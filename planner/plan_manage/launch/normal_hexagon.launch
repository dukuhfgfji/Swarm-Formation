      <arg name="init_x" value="-21.46"/>
      <arg name="init_y" value="-3.54"/>
      <arg name="init_z" value="1.00"/>

      <arg name="target_x" value="28.54"/>
      <arg name="target_y" value="-3.54"/>
      <arg name="target_z" value="1.00"/>

      <arg name="map_size_x" value="$(arg map_size_x)"/>
      <arg name="map_size_y" value="$(arg map_size_y)"/>
