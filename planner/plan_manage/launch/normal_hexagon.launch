      <arg name="init_y" value="-5.00"/>
      <arg name="init_z" value="0.40"/>

      <arg name="target_x" value="25.00"/>
      <arg name="target_y" value="-5.00"/>
      <arg name="target_z" value="0.40"/>

      <arg name="map_size_x" value="$(arg map_size_x)"/>
      <arg name="map_size_y" value="$(arg map_size_y)"/>
      <arg name="map_size_z" value="$(arg map_size_z)"/>
      <arg name="odom_topic" value="$(arg odom_topic)"/>

    </include>
  </group>

  <group ns="drone_5" if="$(eval swarm_num>5)">
    <include file="$(find ego_planner)/launch/run_in_sim.launch">
      <arg name="drone_id" value="5"/>

      <arg name="init_x" value="-20.38"/>
      <arg name="init_y" value="-1.91"/>
      <arg name="init_z" value="0.50"/>

      <arg name="target_x" value="29.62"/>
      <arg name="target_y" value="-1.91"/>
      <arg name="target_z" value="0.50"/>

      <arg name="map_size_x" value="$(arg map_size_x)"/>
      <arg name="map_size_y" value="$(arg map_size_y)"/>
      <arg name="map_size_z" value="$(arg map_size_z)"/>
      <arg name="odom_topic" value="$(arg odom_topic)"/>

